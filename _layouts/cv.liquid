---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <!-- Gated CV PDF download -->
  <div class="cv-gate" style="border:1px solid var(--global-divider-color); border-radius:10px; padding:1rem 1.25rem; margin-bottom:1.5rem;">
    <p style="margin:0 0 .6rem 0;">The full CV is available as a PDF <strong>on request</strong>. If you have an access code, enter it below to download it.</p>
    <div style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center;">
      <input id="cv-code" type="password" placeholder="Access code" autocomplete="off"
             style="padding:.5rem .7rem; border:1px solid var(--global-divider-color); border-radius:8px; background:var(--global-bg-color); color:var(--global-text-color);">
      <button id="cv-unlock" type="button"
              style="padding:.5rem 1.1rem; border:none; border-radius:8px; background:var(--global-theme-color); color:#fff; font-weight:600; cursor:pointer;">Unlock CV PDF</button>
      <a id="cv-dl" href="{{ '/assets/pdf/cv-2b9fbee5e2c78baf.pdf' | relative_url }}" target="_blank" rel="noopener"
         style="display:none; padding:.5rem 1.1rem; border-radius:8px; background:var(--global-theme-color); color:#fff; font-weight:600; text-decoration:none;">Download CV (PDF) &darr;</a>
      <span id="cv-msg" style="font-size:.9rem;"></span>
    </div>
    <p style="margin:.6rem 0 0 0; font-size:.8rem; opacity:.7;">Don't have a code? Request one via the <a href="{{ '/contact/' | relative_url }}">contact page</a>.</p>
  </div>
  <script>
    (function(){
      var CODE = "permission_for_CV";
      var btn = document.getElementById('cv-unlock');
      var inp = document.getElementById('cv-code');
      var dl  = document.getElementById('cv-dl');
      var msg = document.getElementById('cv-msg');
      function tryUnlock(){
        if (inp.value.trim() === CODE){
          dl.style.display='inline-block'; btn.style.display='none'; inp.style.display='none';
          msg.textContent='Unlocked — click Download.'; msg.style.color='var(--global-theme-color)';
        } else {
          msg.textContent='Incorrect code. Please try again.'; msg.style.color='#c0392b';
        }
      }
      btn.addEventListener('click', tryUnlock);
      inp.addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); tryUnlock(); }});
    })();
  </script>

  <article>
    {% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}
    {% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
      {% al_folio_cv_render %}
    {% endif %}
  </article>
</div>
